---
import PolicyDocument from "../components/PolicyDocument.astro";
import { TERMS } from "../constants";
import { TERMS_DOCUMENT as terms } from "../content/terms";
import Layout from "../layouts/Layout.astro";

const linkClass =
  "font-bold text-indigo-600 underline decoration-indigo-300 underline-offset-2 transition-colors duration-200 hover:decoration-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-indigo-400 dark:decoration-indigo-700 dark:hover:decoration-indigo-400";
---

<Layout title={TERMS.title} description={TERMS.description}>
  <main class="flex-1 px-6 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-widest text-indigo-600 uppercase dark:text-indigo-400">{TERMS.eyebrow}</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-balance text-gray-900 sm:text-4xl dark:text-white">
          {TERMS.heading}
        </h1>
        <p class="mt-5 text-base leading-relaxed text-gray-500 dark:text-gray-400">{TERMS.lead}</p>
        <p class="mt-6 font-mono text-xs tracking-wide text-gray-500 dark:text-gray-400">
          {TERMS.versionLabel} <span class="font-bold text-indigo-600 dark:text-indigo-400">{TERMS.version}</span>,{" "}
          {TERMS.effectiveLabel} <time class="font-bold text-indigo-600 dark:text-indigo-400" datetime={TERMS.effectiveDateIso}>{TERMS.effectiveDate}</time>
        </p>
      </div>

      <div class="mt-12 lg:grid lg:grid-cols-4 lg:gap-12">
        <nav class="hidden lg:sticky lg:top-24 lg:block lg:self-start" aria-label={TERMS.outlineLabel}>
          <p class="text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
            {TERMS.outlineLabel}
          </p>
          <ol class="mt-4 flex flex-col gap-2.5">
            {
              terms.sections.map((section) => (
                <li class="flex gap-2 text-sm leading-snug">
                  <span aria-hidden="true" class="font-mono text-xs text-gray-500 dark:text-gray-500">
                    {section.number}
                  </span>
                  <a
                    href={`#terms-${section.number}`}
                    class="min-w-0 text-gray-500 transition-colors duration-200 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-gray-400 dark:hover:text-indigo-400"
                  >
                    {section.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="lg:col-span-3">
          <PolicyDocument policy={terms} idPrefix="terms" />
        </div>
      </div>

      <div class="mt-12 border-t border-gray-200 pt-8 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <p>
          {TERMS.privacyPrefix} <a class={linkClass} href="/privacy">{TERMS.privacyLink}</a>.
        </p>
        <p class="mt-2">
          {TERMS.contactLabel}{" "}
          <a class={linkClass} href={`mailto:${TERMS.contactEmail}`}>{TERMS.contactEmail}</a>.
        </p>
      </div>
    </div>
  </main>
</Layout>
