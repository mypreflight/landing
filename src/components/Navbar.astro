---
import { APP_URL } from "../constants";
import Mark from "./Mark.astro";

const iconHigh =
  "M20 8.69V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12zM12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6m0-10c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4";
const iconLow =
  "M20 15.31 23.31 12 20 8.69V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20zM12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6";
const iconAuto =
  "M10.85 12.65h2.3L12 9zM20 8.69V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12zM14.3 16l-.7-2h-3.2l-.7 2H7.8L11 7h2l3.2 9z";
---

<header
  id="site-header"
  data-scrolled="false"
  class="sticky top-0 z-50 border-b border-transparent bg-white/80 backdrop-blur-md transition-colors duration-300 data-[scrolled=true]:border-gray-200 dark:bg-gray-950/80 dark:data-[scrolled=true]:border-gray-800"
>
  <nav class="flex w-full flex-wrap items-center justify-between px-2 py-2.5 sm:px-4">
    <a href="/" class="flex items-center">
      <Mark class="mr-2.5 h-5 w-auto text-indigo-500 sm:h-7" />
      <span class="self-center text-lg font-normal whitespace-nowrap text-indigo-500 dark:text-indigo-400">
        my<span class="font-bold">preflight</span>
      </span>
    </a>
    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        title="Switch theme"
        aria-label="Switch theme"
        class="rounded-xl p-2 text-gray-500 transition-colors duration-200 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-gray-400 dark:hover:bg-gray-800"
      >
        <svg class="theme-icon-light hidden h-[22px] w-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d={iconHigh}></path>
        </svg>
        <svg class="theme-icon-dark hidden h-[22px] w-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d={iconLow}></path>
        </svg>
        <svg class="theme-icon-auto hidden h-[22px] w-[22px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d={iconAuto}></path>
        </svg>
      </button>
      <a
        href={`${APP_URL}/sign-in`}
        class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition-colors duration-200 hover:bg-indigo-700 focus:ring-4 focus:ring-indigo-500 focus:outline-none dark:text-gray-100 dark:focus:ring-indigo-400"
      >
        Sign In
      </a>
    </div>
  </nav>
</header>

<script>
  const MODES = ["light", "dark", "auto"] as const;
  type Mode = (typeof MODES)[number];

  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");
  const header = document.getElementById("site-header");

  const nextMode = (mode: Mode): Mode => MODES[(MODES.indexOf(mode) + 1) % MODES.length];

  const apply = (mode: Mode) => {
    const dark = mode === "dark" || (mode === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    root.classList.toggle("dark", dark);
    root.dataset.themeMode = mode;
    localStorage.setItem("flowbite-theme-mode", mode);
  };

  toggle?.addEventListener("click", () => {
    apply(nextMode((root.dataset.themeMode as Mode) ?? "auto"));
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (root.dataset.themeMode === "auto") apply("auto");
  });

  const onScroll = () => {
    if (header) header.dataset.scrolled = String(window.scrollY > 10);
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
