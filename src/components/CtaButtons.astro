---
import { CHANGELOGS, CTA_CHANGELOG_LABEL, CTA_DISCORD_LABEL, DISCORD_URL } from "../constants";
import DiscordIcon from "./DiscordIcon.astro";

interface Props {
  class?: string;
  changelog?: boolean;
}

const { class: className, changelog = false } = Astro.props;

const button =
  "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-bold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500";
---

<div class:list={["flex flex-wrap gap-3", className]}>
  <a
    href={DISCORD_URL}
    rel="noopener noreferrer"
    target="_blank"
    class:list={[button, "bg-indigo-600 text-white hover:bg-indigo-700 dark:text-gray-100"]}
  >
    <DiscordIcon class="h-4 w-4 shrink-0" />
    {CTA_DISCORD_LABEL}
  </a>
  {
    changelog && (
      <a
        href={CHANGELOGS.app.path}
        class:list={[
          button,
          "border border-gray-300 bg-white text-gray-900 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:hover:bg-gray-800",
        ]}
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M13.92 3.845a19.362 19.362 0 0 1-6.3 1.98C6.765 5.942 5.89 6 5 6a4 4 0 0 0-.504 7.969 15.97 15.97 0 0 0 1.271 3.34c.397.771 1.342 1 2.05.59l.867-.5c.726-.419.94-1.32.588-2.02-.166-.331-.315-.666-.448-1.004 1.8.357 3.511.963 5.096 1.78A17.964 17.964 0 0 0 15 10c0-2.162-.381-4.235-1.08-6.155ZM15.243 3.097A19.456 19.456 0 0 1 16.5 10c0 2.43-.445 4.758-1.257 6.904l-.03.077a.75.75 0 0 0 1.401.537 20.903 20.903 0 0 0 1.312-5.745 2 2 0 0 0 0-3.546 20.902 20.902 0 0 0-1.312-5.745.75.75 0 0 0-1.4.537l.029.078Z"
            clip-rule="evenodd"></path>
        </svg>
        {CTA_CHANGELOG_LABEL}
      </a>
    )
  }
</div>
