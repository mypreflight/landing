---
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import VisualSlot from "../components/VisualSlot.astro";
import { FEATURES, PRODUCT_LEAD, SITE_NAME } from "../constants";
import Layout from "../layouts/Layout.astro";

const title = `${SITE_NAME}, the electronic flight board for flight simulation`;
const description =
  "MyPreflight is the electronic flight board for flight simulation: dispatch, briefing, check-in and live tracking, in the browser. The site is in preparation.";
---

<Layout title={title} description={description}>
  <main class="flex-1">
    <Hero />

    <Section eyebrow={PRODUCT_LEAD.eyebrow} heading={PRODUCT_LEAD.heading} lead={PRODUCT_LEAD.lead} />

    {
      FEATURES.map((feature, index) => (
        <Section
          index={String(index + 1).padStart(2, "0")}
          eyebrow={feature.eyebrow}
          heading={feature.heading}
          lead={feature.lead}
          reverse={index % 2 === 1}
        >
          <VisualSlot src={feature.shot.light} srcDark={feature.shot.dark} alt={feature.shot.alt} />
        </Section>
      ))
    }

    <Steps />
    <Faq />
    <Cta />
  </main>
</Layout>
