---
import { TRANSPONDER } from "../constants";
import { typeset } from "../lib/changelog";

const { phases, sentLabel, note } = TRANSPONDER.modes;

const runs = phases.map((phase, index) => ({
  ...phase,
  starts: phases[index - 1]?.mode !== phase.mode,
  ends: phases[index + 1]?.mode !== phase.mode,
}));
---

<div class="rounded-2xl border border-gray-200 dark:border-gray-800">
  <ol
    class="flex flex-col divide-y divide-gray-200 sm:flex-row sm:divide-x sm:divide-y-0 dark:divide-gray-800"
  >
    {
      runs.map((phase) => (
        <li
          class="modes-phase flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 px-5 py-4 sm:flex-col sm:flex-nowrap sm:items-stretch sm:justify-start sm:gap-0 sm:px-0 sm:py-5"
          style={`--weight: ${phase.weight}`}
        >
          <span class="text-sm font-bold text-gray-900 sm:px-4 dark:text-white">{phase.label}</span>
          <span
            class:list={[
              "modes-band rounded-full px-2.5 py-0.5 text-xs font-bold tracking-wider sm:mt-3",
              phase.mode === "STBY"
                ? "bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-300"
                : "bg-emerald-50 text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-300",
            ]}
            data-starts={phase.starts ? "" : undefined}
            data-ends={phase.ends ? "" : undefined}
          >
            <span class:list={[!phase.starts && "sm:invisible"]}>{phase.mode}</span>
          </span>
          <span class="w-full text-sm text-pretty text-gray-500 sm:mt-3 sm:px-4 dark:text-gray-400">
            <span class="sr-only">{sentLabel}: </span>
            {phase.sent}
          </span>
        </li>
      ))
    }
  </ol>
  <p
    class="border-t border-gray-200 px-5 py-4 text-sm leading-relaxed text-gray-600 sm:px-4 dark:border-gray-800 dark:text-gray-300"
  >
    {typeset(note)}
  </p>
</div>
