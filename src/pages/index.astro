---
import { DISCORD_URL, SITE_NAME } from "../constants";
import Layout from "../layouts/Layout.astro";

const title = `${SITE_NAME}, the electronic flight board for flight simulation`;
const description =
  "MyPreflight is the electronic flight board for flight simulation: dispatch, briefing, check-in and live tracking, in the browser. The site is in preparation.";
---

<Layout title={title} description={description}>
  <main class="flex flex-1 items-center justify-center px-6 py-24">
    <div class="mx-auto max-w-lg text-center lg:max-w-xl">
      <p class="rise text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
        Site in preparation
      </p>

      <h1
        class="rise mt-6 text-4xl font-bold tracking-tight text-balance text-gray-900 sm:text-5xl dark:text-white"
        style="--rise-delay: 80ms"
      >
        The electronic flight board for flight simulation.
      </h1>

      <p
        class="rise mx-auto mt-6 max-w-sm text-base leading-relaxed text-gray-500 lg:max-w-md dark:text-gray-400"
        style="--rise-delay: 160ms"
      >
        Dispatch, briefing, check-in and live tracking, in the browser. The full site follows shortly.
      </p>

      <p class="rise mt-10" style="--rise-delay: 240ms">
        <a
          href={DISCORD_URL}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 text-sm font-semibold text-gray-800 underline decoration-gray-300 underline-offset-4 transition-colors duration-200 hover:decoration-gray-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-500 dark:text-gray-200 dark:decoration-gray-600 dark:hover:decoration-gray-200"
        >
          <svg class="h-4 w-4 shrink-0 text-discord dark:text-discord-light" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.445.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127c-.598.35-1.22.645-1.873.891a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.056c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028M8.02 15.331c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418m7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418"
            ></path>
          </svg>
          Follow the news on Discord
        </a>
      </p>
    </div>
  </main>
</Layout>
