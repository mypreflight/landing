---
import { render } from "astro:content";
import { CHANGELOG } from "../constants";
import {
  type ChangelogEntry,
  dayKey,
  entryPath,
  formatDay,
  releaseUrl,
  typeset,
  versionAnchor,
} from "../lib/changelog";
import Compare from "./Compare.astro";

interface Props {
  entry: ChangelogEntry;
  level?: "h1" | "h2";
  anchor?: boolean;
  divided?: boolean;
}

const { entry, level = "h2", anchor = false, divided = true } = Astro.props;
const { title, area, version, date, summary, figures, footnote } = entry.data;
const { Content } = await render(entry);
const Heading = level;
const hasBody = Boolean(entry.body?.trim());
---

<article
  id={entry.id}
  data-version={version}
  class:list={[
    "group grid scroll-mt-24 gap-x-8 gap-y-5 py-12 sm:py-16 lg:grid-cols-12",
    divided && "border-t border-gray-200 dark:border-gray-800",
  ]}
>
  <div class="lg:sticky lg:top-24 lg:col-span-2 lg:self-start">
    <p
      id={anchor ? versionAnchor(version) : undefined}
      class="scroll-mt-24 text-xl font-bold tracking-tight text-gray-900 tabular-nums transition-colors duration-200 group-data-current:text-indigo-600 sm:text-2xl dark:text-white dark:group-data-current:text-indigo-400"
    >
      <span class="sr-only">{CHANGELOG.versionLabel} </span>{version}
    </p>
    <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500 lg:mt-2 lg:flex-col dark:text-gray-400">
      <span class="hidden font-bold text-indigo-600 group-data-current:inline lg:group-data-current:block dark:text-indigo-400">
        {CHANGELOG.currentVersionLabel}
      </span>
      <time datetime={dayKey(date)} class="tabular-nums">{formatDay(date)}</time>
      <a
        href={releaseUrl(entry)}
        rel="noopener noreferrer"
        target="_blank"
        class="w-fit underline decoration-gray-300 underline-offset-2 transition-colors duration-200 hover:text-indigo-600 hover:decoration-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:decoration-gray-600 dark:hover:text-indigo-400"
      >
        {CHANGELOG.githubLabel}
      </a>
    </p>
  </div>

  <div class="min-w-0 lg:col-span-10">
    <Heading
      class:list={[
        "font-bold tracking-tight text-balance text-gray-900 dark:text-white",
        level === "h1" ? "text-3xl sm:text-4xl" : "text-xl sm:text-2xl",
      ]}
    >
      {
        level === "h2" ? (
          <a
            href={entryPath(entry)}
            class="transition-colors duration-200 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:hover:text-indigo-400"
          >
            {typeset(title)}
          </a>
        ) : (
          typeset(title)
        )
      }
    </Heading>

    <p class="mt-3">
      <span
        class="inline-flex rounded-md bg-gray-100 px-2 py-0.5 text-xs font-bold whitespace-nowrap text-gray-700 dark:bg-gray-800 dark:text-gray-300"
      >
        {area}
      </span>
    </p>

    <div class="changelog-body mt-4 max-w-prose">
      <p>{typeset(summary)}</p>
      {hasBody && <Content />}
    </div>

    {
      figures.length > 0 && (
        <div class="mt-8 flex flex-col gap-12">
          {figures.map((figure, index) => (
            <Compare
              name={`${entry.id}-${index + 1}`}
              before={figure.before}
              after={figure.after}
              note={index === figures.length - 1 ? footnote : undefined}
            />
          ))}
        </div>
      )
    }
  </div>
</article>
