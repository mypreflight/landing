---
import { CLOSING_CTA } from "../constants";
import CtaButtons from "./CtaButtons.astro";
---

<section class="px-6 py-20 sm:py-28">
  <div class="rise mx-auto max-w-2xl text-center">
    <h2 class="text-2xl font-bold tracking-tight text-balance text-gray-900 sm:text-3xl dark:text-white">
      {CLOSING_CTA.heading}
    </h2>
    <p class="mt-5 text-base leading-relaxed text-gray-500 dark:text-gray-400">{CLOSING_CTA.lead}</p>
    <CtaButtons class="mt-10 justify-center" />
  </div>
</section>
