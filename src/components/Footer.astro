---
import { FOOTER, OWNER_NAME, OWNER_URL, SITE_NAME } from "../constants";
import IsogonicField from "./IsogonicField.astro";
import Mark from "./Mark.astro";

const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden border-t border-gray-200 px-6 py-16 dark:border-gray-800">
  <IsogonicField />

  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-12 lg:grid lg:grid-cols-4 lg:gap-10">
      <div class="lg:col-span-2">
        <div class="flex items-center">
          <Mark class="mr-2.5 h-5 w-auto text-indigo-500" />
          <span class="text-base font-normal text-indigo-500 dark:text-indigo-400">
            my<span class="font-bold">preflight</span>
          </span>
        </div>

        {
          FOOTER.description.map((paragraph) => (
            <p class="mt-5 max-w-prose text-sm leading-relaxed text-gray-500 dark:text-gray-400">{paragraph}</p>
          ))
        }
      </div>

      {
        FOOTER.groups.map((group) => (
          <nav aria-label={group.label}>
            <p class="text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">{group.label}</p>
            <ul class="mt-4 flex flex-col gap-3">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    target={link.external ? "_blank" : undefined}
                    class="text-sm text-gray-600 transition-colors duration-200 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-gray-300 dark:hover:text-indigo-400"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p
      class="mt-12 border-t border-gray-200 pt-8 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400"
    >
      &copy; {year} {SITE_NAME},{FOOTER.creditPrefix}{" "}
      <a
        href={OWNER_URL}
        rel="author noopener noreferrer"
        target="_blank"
        class="underline decoration-gray-300 underline-offset-2 transition-colors duration-200 hover:text-gray-800 hover:decoration-gray-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:decoration-gray-700 dark:hover:text-gray-200 dark:hover:decoration-gray-500"
      >
        {OWNER_NAME}
      </a>
    </p>
  </div>
</footer>
