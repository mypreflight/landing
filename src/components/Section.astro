---
interface Props {
  id?: string;
  index?: string;
  eyebrow: string;
  heading: string;
  lead: string;
  reverse?: boolean;
  wide?: boolean;
}

const { id, index, eyebrow, heading, lead, reverse = false, wide = false } = Astro.props;
const hasVisual = Astro.slots.has("default");
const split = hasVisual && !wide;
---

<section id={id} class="scroll-mt-24 px-6 py-20 sm:py-28">
  <div
    class:list={[
      "mx-auto max-w-6xl",
      split && "flex flex-col gap-10 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16",
    ]}
  >
    <div
      class:list={[
        "rise",
        split && "lg:max-w-lg",
        wide && "max-w-2xl",
        !hasVisual && "mx-auto max-w-2xl text-center",
        reverse && "lg:order-2 lg:justify-self-end",
      ]}
    >
      <p
        class:list={[
          "flex items-center gap-2.5 text-xs font-bold tracking-widest text-indigo-600 uppercase dark:text-indigo-400",
          !hasVisual && "justify-center",
        ]}
      >
        {index && <span aria-hidden="true" class="font-mono font-normal tracking-normal text-gray-400 dark:text-gray-600">{index}</span>}
        {eyebrow}
      </p>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-balance text-gray-900 sm:text-3xl dark:text-white">
        {heading}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-gray-500 dark:text-gray-400">{lead}</p>
    </div>

    {
      hasVisual && (
        <div class:list={["rise", reverse && "lg:order-1", wide && "mt-12"]} style="--rise-delay: 120ms">
          <slot />
        </div>
      )
    }
  </div>
</section>
