---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import { CHANGELOG, CHANGELOGS, type ChangelogProduct } from "../../../constants";
import Layout from "../../../layouts/Layout.astro";
import {
  type ChangelogEntry as Entry,
  entryPath,
  getChangelog,
  PRODUCTS,
  pagePath,
  typeset,
} from "../../../lib/changelog";

export async function getStaticPaths() {
  const routes = await Promise.all(
    PRODUCTS.map(async (product) => {
      const entries = await getChangelog(product);
      return entries.map((entry, index) => ({
        params: { product, slug: entry.id },
        props: { product, entry, later: entries[index - 1], earlier: entries[index + 1] },
      }));
    }),
  );
  return routes.flat();
}

interface Props {
  product: ChangelogProduct;
  entry: Entry;
  later?: Entry;
  earlier?: Entry;
}

const { product, entry, later, earlier } = Astro.props;
const changelog = CHANGELOGS[product];
const title = `${typeset(entry.data.title)}, ${changelog.longTitle}`;
const neighbours = [
  { label: CHANGELOG.earlierLabel, entry: earlier },
  { label: CHANGELOG.laterLabel, entry: later },
].flatMap(({ label, entry: neighbour }) => (neighbour ? [{ label, entry: neighbour }] : []));
---

<Layout title={title} description={typeset(entry.data.summary)}>
  <link slot="head" rel="alternate" type="application/atom+xml" href={changelog.feedPath} title={changelog.longTitle} />

  <main class="changelog flex-1 px-6 pt-36 pb-20 sm:pt-44 sm:pb-28">
    <div class="mx-auto max-w-6xl">
      <a
        href={pagePath(product, 1)}
        class="inline-flex items-center gap-1.5 text-sm font-bold text-gray-500 transition-colors duration-200 hover:text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-gray-400 dark:hover:text-indigo-400"
      >
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z"
            clip-rule="evenodd"></path>
        </svg>
        {changelog.name} {CHANGELOG.heading.toLowerCase()}
      </a>

      <ChangelogEntry entry={entry} level="h1" anchor divided={false} />

      {
        neighbours.length > 0 && (
          <nav
            aria-label={CHANGELOG.neighboursLabel}
            class="grid gap-x-8 gap-y-6 border-t border-gray-200 pt-8 sm:grid-cols-2 lg:grid-cols-12 dark:border-gray-800"
          >
            {neighbours.map((neighbour) => (
              <a
                href={entryPath(neighbour.entry)}
                class:list={[
                  "group text-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-500 lg:col-span-5",
                  neighbour.label === CHANGELOG.earlierLabel ? "lg:col-start-3" : "sm:col-start-2 sm:text-end lg:col-start-8",
                ]}
              >
                <span class="text-gray-500 dark:text-gray-400">
                  {neighbour.label} · {neighbour.entry.data.version}
                </span>
                <span class="mt-1 block text-base font-bold text-balance text-gray-900 transition-colors duration-200 group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400">
                  {typeset(neighbour.entry.data.title)}
                </span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </main>
</Layout>
