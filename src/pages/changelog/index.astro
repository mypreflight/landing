---
import { CHANGELOG, CHANGELOGS } from "../../constants";
import { pagePath } from "../../lib/changelog";

const target = pagePath("app", 1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{CHANGELOG.title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>{CHANGELOG.movedLabel} <a href={target}>{CHANGELOGS.app.title}</a>.</p>
  </body>
</html>
