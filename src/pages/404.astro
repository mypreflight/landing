---
import SplitFlap from "../components/SplitFlap.astro";
import { APP_PATH_PREFIXES, APP_URL, DISCORD_URL, NOT_FOUND } from "../constants";
import Layout from "../layouts/Layout.astro";
---

<Layout title={NOT_FOUND.title} description={NOT_FOUND.description} robots="noindex, follow">
  <Fragment slot="head">
    <script is:inline define:vars={{ appUrl: APP_URL, prefixes: APP_PATH_PREFIXES }}>
      (() => {
        const path = window.location.pathname.replace(/\/$/, "") || "/";
        if (!prefixes.some((prefix) => path === prefix || path.startsWith(`${prefix}/`))) return;
        window.location.replace(appUrl + path + window.location.search + window.location.hash);
      })();
    </script>
  </Fragment>

  <main class="flex flex-1 items-center px-6 py-24 sm:py-32">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-center text-center">
      <h1>
        <SplitFlap text={NOT_FOUND.display} label={NOT_FOUND.display} size="clamp(3.25rem, 11vw, 5.5rem)" />
        <span
          class="mt-8 block text-2xl font-bold tracking-tight text-balance text-gray-900 sm:text-3xl dark:text-white"
        >
          {NOT_FOUND.heading}
        </span>
      </h1>

      <p class="mt-5 max-w-md text-base leading-relaxed text-gray-500 dark:text-gray-400">{NOT_FOUND.lead}</p>

      <dl class="mt-10 w-full max-w-sm">
        <div
          hidden
          data-requested-row
          class="flex items-baseline justify-between gap-4 border-t border-b border-gray-200 py-3 dark:border-gray-800"
        >
          <dt class="shrink-0 text-xs font-bold tracking-widest text-gray-500 uppercase dark:text-gray-400">
            {NOT_FOUND.requestedLabel}
          </dt>
          <dd class="min-w-0 truncate font-mono text-sm text-gray-700 dark:text-gray-300" data-requested></dd>
        </div>
      </dl>

      <a
        href="/"
        class="mt-10 inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition-colors duration-200 hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-gray-100"
      >
        {NOT_FOUND.action}
      </a>

      <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
        {NOT_FOUND.mistakePrefix}{" "}
        <a
          href={DISCORD_URL}
          rel="noopener noreferrer"
          target="_blank"
          class="font-bold text-indigo-600 underline decoration-indigo-300 underline-offset-2 transition-colors duration-200 hover:decoration-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-indigo-400 dark:decoration-indigo-700 dark:hover:decoration-indigo-400"
        >
          {NOT_FOUND.mistakeLink}
        </a>.
      </p>
    </div>
  </main>

  <script is:inline>
    (() => {
      const rows = Array.from(document.querySelectorAll("[data-flap-row]"));
      const tiles = rows.flatMap((row) => Array.from(row.querySelectorAll("[data-flap]")));

      const requested = document.querySelector("[data-requested]");
      if (requested) {
        const path = window.location.pathname + window.location.search;
        requested.textContent = path.length > 48 ? `${path.slice(0, 47)}…` : path;
        const row = requested.closest("[data-requested-row]");
        if (row) row.hidden = false;
      }

      if (!tiles.length) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const DIGITS = "0123456789";
      const LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
      const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
      const STEP = 62;
      const canAnimate = typeof Element.prototype.animate === "function";

      const poolFor = (char) => (/[0-9]/.test(char) ? DIGITS : LETTERS);
      const pick = (pool) => pool[(Math.random() * pool.length) | 0];

      const fall = (tile, from, duration) => {
        if (!canAnimate) return;
        tile.animate([{ transform: `rotateX(${from}deg)` }, { transform: "rotateX(0deg)" }], {
          duration,
          easing: EASE,
        });
      };

      for (const tile of tiles) tile.textContent = pick(poolFor(tile.dataset.flap));

      let last = 0;
      tiles.forEach((tile, index) => {
        const final = tile.dataset.flap;
        const pool = poolFor(final);
        const spins = 5 + (index % 5);
        const delay = 80 + index * 55;
        last = Math.max(last, delay + spins * STEP);

        window.setTimeout(() => {
          let done = 0;
          const cycle = window.setInterval(() => {
            if (done >= spins) {
              window.clearInterval(cycle);
              tile.textContent = final;
              fall(tile, -74, 300);
              return;
            }
            tile.textContent = pick(pool);
            fall(tile, -52, STEP + 18);
            done += 1;
          }, STEP);
        }, delay);
      });

      window.setTimeout(() => {
        for (const tile of tiles) tile.textContent = tile.dataset.flap;
      }, last + 1400);
    })();
  </script>
</Layout>
