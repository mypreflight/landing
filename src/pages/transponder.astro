---
import Console from "../components/Console.astro";
import Section from "../components/Section.astro";
import TransponderDownload from "../components/TransponderDownload.astro";
import TransponderModes from "../components/TransponderModes.astro";
import { TRANSPONDER, TRANSPONDER_SOURCE_URL } from "../constants";
import Layout from "../layouts/Layout.astro";
import { getChangelog, pagePath, typeset } from "../lib/changelog";
import { bandOf, CONSOLE_FRAMES, consoleBoxes, cropFrame, trimFrame } from "../lib/console";

const { dashboard, signIn } = CONSOLE_FRAMES;
const [latest] = await getChangelog("transponder");
const version = latest?.data.version ?? dashboard.version;
const links = Object.fromEntries(TRANSPONDER.callouts.map((callout) => [callout.key, callout.href]));
const { modes, setup, footprint, integrations, closing } = TRANSPONDER;
const specLine = [version, TRANSPONDER.size, TRANSPONDER.platform].join(" · ");

const textLink =
  "inline-flex items-center gap-1 font-bold text-gray-700 underline decoration-gray-300 underline-offset-4 transition-colors duration-200 hover:text-indigo-600 hover:decoration-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:text-gray-200 dark:decoration-gray-600 dark:hover:text-indigo-400";
---

<Layout title={TRANSPONDER.title} description={TRANSPONDER.description}>
  <main class="flex-1">
    <section class="px-6 pt-32 pb-16 sm:pt-36 sm:pb-24">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8">
          <h1
            class="text-4xl leading-tight font-bold tracking-tight text-balance text-gray-900 sm:text-5xl lg:col-span-7 dark:text-white"
          >
            {TRANSPONDER.heading}
          </h1>
          <p class="text-lg leading-relaxed text-pretty text-gray-600 lg:col-span-5 dark:text-gray-300">
            {typeset(TRANSPONDER.lead)}
          </p>
        </div>

        <div class="console-stage mt-10 grid gap-10 lg:mt-8 lg:grid-cols-12 lg:gap-8">
          <div class="min-w-0 lg:col-span-7">
            <Console
              frame={dashboard}
              label={TRANSPONDER.consoleLabel}
              boxes={consoleBoxes(dashboard)}
              links={links}
              natural
              animated
              class="console-compact console-tilt"
            >
              <div slot="bar" class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:gap-6">
                <div class="min-w-0">
                  <p class="truncate font-console text-sm text-gray-100">{TRANSPONDER.file}</p>
                  <p class="mt-1 text-sm text-gray-400 tabular-nums">
                    <span class="sr-only">{TRANSPONDER.versionLabel} </span>{specLine}
                  </p>
                </div>
                <TransponderDownload class="w-full sm:ms-auto sm:w-auto" />
              </div>
            </Console>
            <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
              <span>{TRANSPONDER.freeNote}</span>
              <span>{TRANSPONDER.checksumNote}</span>
              <a href={pagePath("transponder", 1)} class={textLink}>
                {TRANSPONDER.releaseNotesLabel} in {version}
              </a>
            </p>
          </div>

          <nav aria-label={TRANSPONDER.calloutsLabel} class="lg:col-span-5 lg:pt-1">
            <ol class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-1 lg:gap-y-3">
              {
                TRANSPONDER.callouts.map((callout) => (
                  <li>
                    <a
                      href={callout.href}
                      data-key={callout.key}
                      class="callout flex gap-3.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-500"
                    >
                      <span class="callout-key grid size-7 shrink-0 place-items-center rounded-full text-sm font-bold text-gray-700 tabular-nums ring-1 ring-gray-300 ring-inset dark:text-gray-200 dark:ring-gray-700">
                        {callout.key}
                      </span>
                      <span class="min-w-0">
                        <span class="callout-title block text-base font-bold text-gray-900 dark:text-white">
                          {callout.title}
                        </span>
                        <span class="mt-1 block text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                          {typeset(callout.detail)}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </div>
    </section>

    <Section id={modes.id} eyebrow={modes.eyebrow} heading={modes.heading} lead={typeset(modes.lead)} wide>
      <TransponderModes />
    </Section>

    <Section id={setup.id} eyebrow={setup.eyebrow} heading={setup.heading} lead={typeset(setup.lead)} wide>
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
        <ol class="flex flex-col gap-7 lg:col-span-6">
          {
            setup.steps.map((step, index) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold text-gray-900 tabular-nums ring-1 ring-gray-300 ring-inset dark:text-white dark:ring-gray-700">
                  {index + 1}
                </span>
                <span class="min-w-0 pt-1">
                  <span class="block text-base font-bold text-gray-900 dark:text-white">{step.title}</span>
                  <span class="mt-1.5 block max-w-prose text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                    {typeset(step.detail)}
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
        <div class="min-w-0 lg:col-span-6">
          <Console
            frame={trimFrame(signIn)}
            label={setup.consoleLabel}
            natural
            class="console-compact lg:sticky lg:top-28"
          />
        </div>
      </div>
    </Section>

    <Section
      id={footprint.id}
      eyebrow={footprint.eyebrow}
      heading={footprint.heading}
      lead={typeset(footprint.lead)}
      wide
    >
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
        <dl class="border-t border-gray-200 lg:col-span-8 dark:border-gray-800">
          {
            footprint.specs.map((spec) => (
              <div class="grid gap-1 border-b border-gray-200 py-4 sm:grid-cols-4 sm:gap-6 dark:border-gray-800">
                <dt class="pt-0.5 text-xs font-bold tracking-wider text-gray-500 uppercase dark:text-gray-400">
                  {spec.term}
                </dt>
                <dd class="text-base text-pretty text-gray-900 tabular-nums sm:col-span-3 dark:text-gray-100">
                  {typeset(spec.value)}
                </dd>
              </div>
            ))
          }
          <div class="grid gap-1 border-b border-gray-200 py-4 sm:grid-cols-4 sm:gap-6 dark:border-gray-800">
            <dt class="pt-0.5 text-xs font-bold tracking-wider text-gray-500 uppercase dark:text-gray-400">
              {TRANSPONDER.sourceLabel}
            </dt>
            <dd class="text-base sm:col-span-3">
              <a href={TRANSPONDER_SOURCE_URL} rel="noopener noreferrer" target="_blank" class={textLink}>
                github.com/mypreflight/transponder-app
              </a>
            </dd>
          </div>
        </dl>

        <div class="lg:col-span-4">
          <h3 class="text-xs font-bold tracking-wider text-gray-500 uppercase dark:text-gray-400">
            {footprint.keysHeading}
          </h3>
          <dl class="mt-4 flex flex-col gap-3">
            {
              footprint.keys.map((entry) => (
                <div class="flex items-baseline gap-4">
                  <dt class="w-12 shrink-0">
                    <kbd class="inline-flex min-w-8 justify-center rounded-md border border-gray-300 bg-white px-1.5 py-0.5 font-console text-sm text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
                      {entry.key}
                    </kbd>
                  </dt>
                  <dd class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">{entry.action}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </Section>

    <Section
      id={integrations.id}
      eyebrow={integrations.eyebrow}
      heading={integrations.heading}
      lead={typeset(integrations.lead)}
      wide
    >
      <div class="flex flex-col gap-14">
        {
          integrations.items.map((item) => (
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-10">
              <Console
                frame={cropFrame(dashboard, bandOf(dashboard, item.key))}
                label={item.consoleLabel}
                natural
                class="console-compact lg:shrink-0"
              />
              <div class="min-w-0 lg:flex-1 lg:pt-4">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">{item.title}</h3>
                <p class="mt-2 max-w-prose text-base leading-relaxed text-gray-600 dark:text-gray-300">
                  {typeset(item.body)}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </Section>

    <section class="px-6 pt-8 pb-24 sm:pb-32">
      <div class="rise mx-auto flex max-w-2xl flex-col items-center text-center">
        <h2 class="text-2xl font-bold tracking-tight text-balance text-gray-900 sm:text-3xl dark:text-white">
          {closing.heading}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-gray-500 dark:text-gray-400">{typeset(closing.lead)}</p>
        <TransponderDownload size="lg" class="mt-10 w-full sm:w-auto" />
        <p class="mt-5 text-sm text-gray-500 tabular-nums dark:text-gray-400">
          <span class="sr-only">{TRANSPONDER.versionLabel} </span>{specLine} · {TRANSPONDER.sim}
        </p>
        <p class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
          <a href={pagePath("transponder", 1)} class={textLink}>{TRANSPONDER.releaseNotesLabel} in {version}</a>
          <a href={TRANSPONDER_SOURCE_URL} rel="noopener noreferrer" target="_blank" class={textLink}>
            {TRANSPONDER.sourceLabel}
          </a>
        </p>
      </div>
    </section>
  </main>
</Layout>
