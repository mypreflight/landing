---
import { FAQ } from "../constants";
---

<section class="px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="rise mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold tracking-widest text-indigo-600 uppercase dark:text-indigo-400">
        {FAQ.eyebrow}
      </p>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-balance text-gray-900 sm:text-3xl dark:text-white">
        {FAQ.heading}
      </h2>
    </div>

    <dl class="mx-auto mt-14 grid max-w-4xl gap-10 md:grid-cols-2">
      {
        FAQ.items.map((item) => (
          <div class="rise">
            <dt class="text-base font-bold text-gray-900 dark:text-white">{item.question}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{item.answer}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
