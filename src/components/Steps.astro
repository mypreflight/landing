---
import { HOW_IT_WORKS } from "../constants";
---

<section class="px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="rise mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold tracking-widest text-indigo-600 uppercase dark:text-indigo-400">
        {HOW_IT_WORKS.eyebrow}
      </p>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-balance text-gray-900 sm:text-3xl dark:text-white">
        {HOW_IT_WORKS.heading}
      </h2>
    </div>

    <div class="relative mt-14">
      <div
        aria-hidden="true"
        class="absolute top-4 right-0 left-0 hidden h-px bg-gray-200 md:block dark:bg-gray-800"
      >
      </div>
      <ol class="relative grid gap-10 md:grid-cols-4 md:gap-8">
      {
        HOW_IT_WORKS.steps.map((step, index) => (
          <li class="rise" style={`--rise-delay: ${index * 80}ms`}>
            <span class="flex size-8 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">
              {index + 1}
            </span>
            <h3 class="mt-4 text-base font-bold text-gray-900 dark:text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{step.detail}</p>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>
