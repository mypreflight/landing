---
import { CHANGELOG, DISCORD_URL } from "../constants";
import DiscordIcon from "./DiscordIcon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const button =
  "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-bold whitespace-nowrap transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500";
---

<div class:list={["grid gap-3 sm:flex sm:flex-wrap", className]}>
  <a
    href={DISCORD_URL}
    rel="noopener noreferrer"
    target="_blank"
    class:list={[button, "bg-indigo-600 text-white hover:bg-indigo-700 dark:text-gray-100"]}
  >
    <DiscordIcon class="size-4 shrink-0" />
    {CHANGELOG.discordLabel}
  </a>
  <a
    href={CHANGELOG.feedPath}
    class:list={[
      button,
      "border border-gray-300 bg-white text-gray-900 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:hover:bg-gray-800",
    ]}
  >
    <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path
        d="M3.75 3a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4c6.075 0 11 4.925 11 11v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V16C17 8.82 11.18 3 4 3h-.25Z"
      ></path>
      <path
        d="M3 8.75A.75.75 0 0 1 3.75 8H4a8 8 0 0 1 8 8v.25a.75.75 0 0 1-.75.75h-.5a.75.75 0 0 1-.75-.75V16a6 6 0 0 0-6-6h-.25A.75.75 0 0 1 3 9.25v-.5ZM7 15a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"
      ></path>
    </svg>
    {CHANGELOG.feedLabel}
  </a>
</div>
